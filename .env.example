DEPLOYMENT_MODE=demo
DEMO_ENABLED=true
AUTH_SECRET=replace-with-random-32-byte-secret
DATABASE_URL=postgresql://practisync:local-demo-only@localhost:5433/practisync_demo
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
EDUCATIONAL_EMAIL_DOMAINS=
RESEND_API_KEY=
# Direct Notion API access for coding-agent ticket creation (keep real values in .env.local).
NOTION_API_KEY=
NOTION_TICKETS_DATA_SOURCE_ID=
PRIVATE_STORAGE_ENDPOINT=
# Start pnpm documents:up and pnpm documents:worker alongside the web server.
DOCUMENT_CONVERTER_URL=http://127.0.0.1:3008
DOCUMENT_REDIS_URL=redis://127.0.0.1:6386
DOCUMENT_SCANNER_URL=tcp://127.0.0.1:3318
DOCUMENT_FONTS_DIR=.local/document-fonts
DOCUMENT_WORKER_CONCURRENCY=2
DOCUMENT_PREVIEW_RATE_PER_MINUTE=90
DOCUMENT_RETENTION_DAYS=30
# Change when the converter image or fonts change to invalidate cached renders.
DOCUMENT_RENDER_PROFILE=libreoffice-native-v1
# Additional font families installed in the converter image, separated by |.
DOCUMENT_INSTALLED_FONTS=
# Absolute Poppler executable path, if pdftoppm is not on PATH (fidelity test only).
PDFTOPPM_PATH=
