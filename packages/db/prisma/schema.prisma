generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeploymentMode {
  DEMO
  INSTITUTIONAL
}

enum Role {
  SUPER_ADMIN
  COORDINATOR
  SUPERVISOR
  STUDENT
}

enum AccountStatus {
  ACTIVE
  DISABLED
  INVITED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PlacementStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ConfirmationStatus {
  CONFIRMED
  DISPUTED
}

enum ScanStatus {
  QUARANTINED
  CLEAN
  REJECTED
}

enum EvaluationKind {
  BASELINE
  FINAL
  WEEKLY
  MONTHLY
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REVISION_REQUESTED
}

enum AssessmentCadence {
  WEEKLY
  MONTHLY
  BOTH
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ApplicationStatus {
  SUBMITTED
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum AudienceScope {
  UNIVERSITY
  DEPARTMENT
  CLASS
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model Tenant {
  id                             String                    @id @default(cuid())
  createdAt                      DateTime                  @default(now())
  updatedAt                      DateTime                  @updatedAt
  name                           String
  timezone                       String                    @default("Asia/Manila")
  mode                           DeploymentMode            @default(INSTITUTIONAL)
  allowedGoogleDomains           String[]
  settingsVersion                Int                       @default(1)
  userRecords                    User[]
  accountRecords                 Account[]
  sessionRecords                 Session[]
  verificationTokenRecords       VerificationToken[]
  membershipRecords              Membership[]
  departmentRecords              Department[]
  courseRecords                  Course[]
  academicPeriodRecords          AcademicPeriod[]
  studentProfileRecords          StudentProfile[]
  supervisorProfileRecords       SupervisorProfile[]
  companyRecords                 Company[]
  companyMembershipRecords       CompanyMembership[]
  coursePolicyScopeRecords       CoursePolicyScope[]
  hoursPolicyRecords             HoursPolicy[]
  classSpaceRecords              ClassSpace[]
  joinCodeRecords                JoinCode[]
  enrollmentRecords              Enrollment[]
  placementRecords               Placement[]
  placementSupervisorRecords     PlacementSupervisor[]
  policyMigrationRecords         PolicyMigration[]
  dailyEntryRecords              DailyEntry[]
  timeIntervalRecords            TimeInterval[]
  entryRevisionRecords           EntryRevision[]
  intervalRevisionRecords        IntervalRevision[]
  entryConfirmationRecords       EntryConfirmation[]
  storageObjectRecords           StorageObject[]
  companyRecordRecords           CompanyRecord[]
  competencyFrameworkRecords     CompetencyFramework[]
  competencyRecords              Competency[]
  courseFrameworkRecords         CourseFramework[]
  rubricDimensionRecords         RubricDimension[]
  evaluationRecords              Evaluation[]
  assessmentScheduleRecords      AssessmentSchedule[]
  evaluationScoreRecords         EvaluationScore[]
  evaluationRevisionRecords      EvaluationRevision[]
  evaluationScoreRevisionRecords EvaluationScoreRevision[]
  documentTypeRecords            DocumentType[]
  requirementSetRecords          RequirementSet[]
  documentRequirementRecords     DocumentRequirement[]
  documentSubmissionRecords      DocumentSubmission[]
  incidentCaseRecords            IncidentCase[]
  caseHandlerRecords             CaseHandler[]
  caseMessageRecords             CaseMessage[]
  caseAttachmentRecords          CaseAttachment[]
  caseEscalationRecords          CaseEscalation[]
  sensitiveAccessRecords         SensitiveAccess[]
  jobPostingRecords              JobPosting[]
  jobCompetencyRecords           JobCompetency[]
  jobEligibilityRecords          JobEligibility[]
  applicationRecords             Application[]
  applicationHistoryRecords      ApplicationHistory[]
  announcementRecords            Announcement[]
  announcementAudienceRecords    AnnouncementAudience[]
  readReceiptRecords             ReadReceipt[]
  directoryProfileRecords        DirectoryProfile[]
  companyReviewRecords           CompanyReview[]
  completionChecklistRecords     CompletionChecklist[]
  checklistItemRecords           ChecklistItem[]
  completionRecordRecords        CompletionRecord[]
  completionItemRecords          CompletionItem[]
  portfolioJobRecords            PortfolioJob[]
  notificationRecords            Notification[]
  outboxEventRecords             OutboxEvent[]
  backgroundJobRecords           BackgroundJob[]
  idempotencyKeyRecords          IdempotencyKey[]
  auditEventRecords              AuditEvent[]
  loginAttemptRecords            LoginAttempt[]
}

model User {
  id                            String               @id @default(cuid())
  tenantId                      String
  tenant                        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt                     DateTime             @default(now())
  updatedAt                     DateTime             @updatedAt
  name                          String?
  email                         String?              @unique
  emailVerified                 DateTime?
  image                         String?
  username                      String               @unique
  passwordHash                  String?
  status                        AccountStatus        @default(ACTIVE)
  sessionVersion                Int                  @default(1)
  isDemo                        Boolean              @default(false)
  account_userId                Account[]            @relation("Account_userId")
  session_userId                Session[]            @relation("Session_userId")
  membership_userId             Membership[]         @relation("Membership_userId")
  studentProfile_userId         StudentProfile[]     @relation("StudentProfile_userId")
  supervisorProfile_userId      SupervisorProfile[]  @relation("SupervisorProfile_userId")
  hoursPolicy_authorId          HoursPolicy[]        @relation("HoursPolicy_authorId")
  classSpace_coordinatorId      ClassSpace[]         @relation("ClassSpace_coordinatorId")
  policyMigration_actorId       PolicyMigration[]    @relation("PolicyMigration_actorId")
  entryRevision_actorId         EntryRevision[]      @relation("EntryRevision_actorId")
  storageObject_ownerId         StorageObject[]      @relation("StorageObject_ownerId")
  evaluation_evaluatorId        Evaluation[]         @relation("Evaluation_evaluatorId")
  evaluation_reviewerId         Evaluation[]         @relation("Evaluation_reviewerId")
  assessmentSchedule_configuredById AssessmentSchedule[] @relation("AssessmentSchedule_configuredById")
  documentSubmission_reviewerId DocumentSubmission[] @relation("DocumentSubmission_reviewerId")
  incidentCase_reporterId       IncidentCase[]       @relation("IncidentCase_reporterId")
  incidentCase_coordinatorId    IncidentCase[]       @relation("IncidentCase_coordinatorId")
  caseHandler_userId            CaseHandler[]        @relation("CaseHandler_userId")
  caseMessage_authorId          CaseMessage[]        @relation("CaseMessage_authorId")
  caseEscalation_actorId        CaseEscalation[]     @relation("CaseEscalation_actorId")
  caseEscalation_recipientId    CaseEscalation[]     @relation("CaseEscalation_recipientId")
  sensitiveAccess_actorId       SensitiveAccess[]    @relation("SensitiveAccess_actorId")
  jobPosting_authorId           JobPosting[]         @relation("JobPosting_authorId")
  applicationHistory_actorId    ApplicationHistory[] @relation("ApplicationHistory_actorId")
  announcement_authorId         Announcement[]       @relation("Announcement_authorId")
  readReceipt_userId            ReadReceipt[]        @relation("ReadReceipt_userId")
  completionRecord_decidedById  CompletionRecord[]   @relation("CompletionRecord_decidedById")
  portfolioJob_requestedById    PortfolioJob[]       @relation("PortfolioJob_requestedById")
  notification_userId           Notification[]       @relation("Notification_userId")
  idempotencyKey_actorId        IdempotencyKey[]     @relation("IdempotencyKey_actorId")
  auditEvent_actorId            AuditEvent[]         @relation("AuditEvent_actorId")

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model Account {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  userId            String
  user              User     @relation("Account_userId", fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([provider, providerAccountId])
  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model Session {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessionToken String   @unique
  expires      DateTime
  userId       String
  user         User     @relation("Session_userId", fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model VerificationToken {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model Membership {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role
  active    Boolean  @default(true)
  userId    String
  user      User     @relation("Membership_userId", fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model Department {
  id                                String                 @id @default(cuid())
  tenantId                          String
  tenant                            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt                         DateTime               @default(now())
  updatedAt                         DateTime               @updatedAt
  name                              String
  code                              String
  archivedAt                        DateTime?
  course_departmentId               Course[]               @relation("Course_departmentId")
  announcementAudience_departmentId AnnouncementAudience[] @relation("AnnouncementAudience_departmentId")

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model Course {
  id                           String                @id @default(cuid())
  tenantId                     String
  tenant                       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt
  name                         String
  code                         String
  archivedAt                   DateTime?
  departmentId                 String
  department                   Department            @relation("Course_departmentId", fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  studentProfile_courseId      StudentProfile[]      @relation("StudentProfile_courseId")
  coursePolicyScope_courseId   CoursePolicyScope[]   @relation("CoursePolicyScope_courseId")
  hoursPolicy_courseId         HoursPolicy[]         @relation("HoursPolicy_courseId")
  classSpace_courseId          ClassSpace[]          @relation("ClassSpace_courseId")
  courseFramework_courseId     CourseFramework[]     @relation("CourseFramework_courseId")
  requirementSet_courseId      RequirementSet[]      @relation("RequirementSet_courseId")
  jobEligibility_courseId      JobEligibility[]      @relation("JobEligibility_courseId")
  completionChecklist_courseId CompletionChecklist[] @relation("CompletionChecklist_courseId")
  assessmentSchedule           AssessmentSchedule?

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model AcademicPeriod {
  id                           String                @id @default(cuid())
  tenantId                     String
  tenant                       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt
  name                         String
  startsAt                     DateTime
  endsAt                       DateTime
  active                       Boolean               @default(false)
  hoursPolicy_periodId         HoursPolicy[]         @relation("HoursPolicy_periodId")
  classSpace_periodId          ClassSpace[]          @relation("ClassSpace_periodId")
  placement_periodId           Placement[]           @relation("Placement_periodId")
  requirementSet_periodId      RequirementSet[]      @relation("RequirementSet_periodId")
  completionChecklist_periodId CompletionChecklist[] @relation("CompletionChecklist_periodId")

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model StudentProfile {
  id                      String          @id @default(cuid())
  tenantId                String
  tenant                  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  studentNumber           String
  userId                  String
  courseId                String
  user                    User            @relation("StudentProfile_userId", fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  course                  Course          @relation("StudentProfile_courseId", fields: [tenantId, courseId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  enrollment_studentId    Enrollment[]    @relation("Enrollment_studentId")
  placement_studentId     Placement[]     @relation("Placement_studentId")
  application_studentId   Application[]   @relation("Application_studentId")
  companyReview_studentId CompanyReview[] @relation("CompanyReview_studentId")

  @@unique([tenantId, userId])
  @@unique([tenantId, studentNumber])
  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model SupervisorProfile {
  id                               String                @id @default(cuid())
  tenantId                         String
  tenant                           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt                        DateTime              @default(now())
  updatedAt                        DateTime              @updatedAt
  verifiedAt                       DateTime?
  verificationStatus               ReviewStatus          @default(PENDING)
  userId                           String
  user                             User                  @relation("SupervisorProfile_userId", fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  companyMembership_supervisorId   CompanyMembership[]   @relation("CompanyMembership_supervisorId")
  coursePolicyScope_supervisorId   CoursePolicyScope[]   @relation("CoursePolicyScope_supervisorId")
  placementSupervisor_supervisorId PlacementSupervisor[] @relation("PlacementSupervisor_supervisorId")
  entryConfirmation_supervisorId   EntryConfirmation[]   @relation("EntryConfirmation_supervisorId")

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model Company {
  id                          String              @id @default(cuid())
  tenantId                    String
  tenant                      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  name                        String
  industry                    String
  address                     String?
  verificationStatus          ReviewStatus        @default(PENDING)
  archivedAt                  DateTime?
  companyMembership_companyId CompanyMembership[] @relation("CompanyMembership_companyId")
  placement_companyId         Placement[]         @relation("Placement_companyId")
  jobPosting_companyId        JobPosting[]        @relation("JobPosting_companyId")
  directoryProfile_companyId  DirectoryProfile[]  @relation("DirectoryProfile_companyId")
  companyReview_companyId     CompanyReview[]     @relation("CompanyReview_companyId")

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model CompanyMembership {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  active       Boolean           @default(true)
  canPost      Boolean           @default(false)
  companyId    String
  supervisorId String
  company      Company           @relation("CompanyMembership_companyId", fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  supervisor   SupervisorProfile @relation("CompanyMembership_supervisorId", fields: [tenantId, supervisorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, companyId, supervisorId])
  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model CoursePolicyScope {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  active       Boolean           @default(true)
  supervisorId String
  courseId     String
  supervisor   SupervisorProfile @relation("CoursePolicyScope_supervisorId", fields: [tenantId, supervisorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  course       Course            @relation("CoursePolicyScope_courseId", fields: [tenantId, courseId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, supervisorId, courseId])
  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model HoursPolicy {
  id                       String            @id @default(cuid())
  tenantId                 String
  tenant                   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  version                  Int
  requiredMinutes          Int
  isFictional              Boolean           @default(false)
  courseId                 String
  periodId                 String
  authorId                 String
  course                   Course            @relation("HoursPolicy_courseId", fields: [tenantId, courseId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  period                   AcademicPeriod    @relation("HoursPolicy_periodId", fields: [tenantId, periodId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  author                   User              @relation("HoursPolicy_authorId", fields: [tenantId, authorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  placement_policyId       Placement[]       @relation("Placement_policyId")
  policyMigration_policyId PolicyMigration[] @relation("PolicyMigration_policyId")

  @@unique([tenantId, courseId, periodId, version])
  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model ClassSpace {
  id                           String                 @id @default(cuid())
  tenantId                     String
  tenant                       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  name                         String
  section                      String
  archivedAt                   DateTime?
  version                      Int                    @default(1)
  coordinatorId                String
  courseId                     String
  periodId                     String
  coordinator                  User                   @relation("ClassSpace_coordinatorId", fields: [tenantId, coordinatorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  course                       Course                 @relation("ClassSpace_courseId", fields: [tenantId, courseId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  period                       AcademicPeriod         @relation("ClassSpace_periodId", fields: [tenantId, periodId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  joinCode_classId             JoinCode[]             @relation("JoinCode_classId")
  enrollment_classId           Enrollment[]           @relation("Enrollment_classId")
  placement_classId            Placement[]            @relation("Placement_classId")
  incidentCase_classId         IncidentCase[]         @relation("IncidentCase_classId")
  announcementAudience_classId AnnouncementAudience[] @relation("AnnouncementAudience_classId")

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model JoinCode {
  id             String     @id @default(cuid())
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  codeHash       String     @unique
  expiresAt      DateTime?
  revokedAt      DateTime?
  maxEnrollments Int?
  classId        String
  class          ClassSpace @relation("JoinCode_classId", fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model Enrollment {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  joinedAt  DateTime       @default(now())
  endedAt   DateTime?
  isPrimary Boolean        @default(true)
  classId   String
  studentId String
  class     ClassSpace     @relation("Enrollment_classId", fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  student   StudentProfile @relation("Enrollment_studentId", fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, classId, studentId])
  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model Placement {
  id                              String                @id @default(cuid())
  tenantId                        String
  tenant                          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt                       DateTime              @default(now())
  updatedAt                       DateTime              @updatedAt
  startsAt                        DateTime
  endsAt                          DateTime
  status                          PlacementStatus       @default(ACTIVE)
  requiredMinutes                 Int?
  policyVersion                   Int?
  version                         Int                   @default(1)
  studentId                       String
  companyId                       String
  periodId                        String
  classId                         String
  policyId                        String?
  student                         StudentProfile        @relation("Placement_studentId", fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  company                         Company               @relation("Placement_companyId", fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  period                          AcademicPeriod        @relation("Placement_periodId", fields: [tenantId, periodId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  class                           ClassSpace            @relation("Placement_classId", fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  policy                          HoursPolicy?          @relation("Placement_policyId", fields: [tenantId, policyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  placementSupervisor_placementId PlacementSupervisor[] @relation("PlacementSupervisor_placementId")
  policyMigration_placementId     PolicyMigration[]     @relation("PolicyMigration_placementId")
  dailyEntry_placementId          DailyEntry[]          @relation("DailyEntry_placementId")
  companyRecord_placementId       CompanyRecord[]       @relation("CompanyRecord_placementId")
  evaluation_placementId          Evaluation[]          @relation("Evaluation_placementId")
  documentSubmission_placementId  DocumentSubmission[]  @relation("DocumentSubmission_placementId")
  incidentCase_placementId        IncidentCase[]        @relation("IncidentCase_placementId")
  application_placementId         Application[]         @relation("Application_placementId")
  companyReview_placementId       CompanyReview[]       @relation("CompanyReview_placementId")
  completionRecord_placementId    CompletionRecord[]    @relation("CompletionRecord_placementId")
  portfolioJob_placementId        PortfolioJob[]        @relation("PortfolioJob_placementId")

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model PlacementSupervisor {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  assignedAt   DateTime          @default(now())
  revokedAt    DateTime?
  placementId  String
  supervisorId String
  placement    Placement         @relation("PlacementSupervisor_placementId", fields: [tenantId, placementId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  supervisor   SupervisorProfile @relation("PlacementSupervisor_supervisorId", fields: [tenantId, supervisorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, placementId, supervisorId])
  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model PolicyMigration {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  oldMinutes  Int?
  newMinutes  Int
  reason      String
  placementId String
  policyId    String
  actorId     String
  placement   Placement   @relation("PolicyMigration_placementId", fields: [tenantId, placementId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  policy      HoursPolicy @relation("PolicyMigration_policyId", fields: [tenantId, policyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  actor       User        @relation("PolicyMigration_actorId", fields: [tenantId, actorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model DailyEntry {
  id                        String              @id @default(cuid())
  tenantId                  String
  tenant                    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  date                      DateTime            @db.Date
  narrative                 String              @db.VarChar(8000)
  submittedAt               DateTime
  version                   Int                 @default(1)
  placementId               String
  placement                 Placement           @relation("DailyEntry_placementId", fields: [tenantId, placementId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  timeInterval_entryId      TimeInterval[]      @relation("TimeInterval_entryId")
  entryRevision_entryId     EntryRevision[]     @relation("EntryRevision_entryId")
  entryConfirmation_entryId EntryConfirmation[] @relation("EntryConfirmation_entryId")

  @@unique([tenantId, id])
  @@index([tenantId, placementId, date])
