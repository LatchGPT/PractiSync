  updatedAt     DateTime           @updatedAt
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  reason        String?
  applicationId String
  actorId       String
  application   Application        @relation("ApplicationHistory_applicationId", fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  actor         User               @relation("ApplicationHistory_actorId", fields: [tenantId, actorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model Announcement {
  id                                  String                 @id @default(cuid())
  tenantId                            String
  tenant                              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt                           DateTime               @default(now())
  updatedAt                           DateTime               @updatedAt
  title                               String                 @db.VarChar(160)
  body                                String                 @db.VarChar(8000)
  status                              PublicationStatus      @default(DRAFT)
  publishedAt                         DateTime?
  authorId                            String
  author                              User                   @relation("Announcement_authorId", fields: [tenantId, authorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  announcementAudience_announcementId AnnouncementAudience[] @relation("AnnouncementAudience_announcementId")
  readReceipt_announcementId          ReadReceipt[]          @relation("ReadReceipt_announcementId")

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model AnnouncementAudience {
