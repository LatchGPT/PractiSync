model CompletionRecord {
  id                          String              @id @default(cuid())
  tenantId                    String
  tenant                      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
