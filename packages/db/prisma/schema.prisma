  department     Department?   @relation("AnnouncementAudience_departmentId", fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  class          ClassSpace?   @relation("AnnouncementAudience_classId", fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

