  decidedBy                   User?               @relation("CompletionRecord_decidedById", fields: [tenantId, decidedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  completionItem_completionId CompletionItem[]    @relation("CompletionItem_completionId")

  @@unique([tenantId, placementId])
  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model CompletionItem {
  id           String           @id @default(cuid())
  tenantId     String
